{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prepbuddy.app/schemas/recipe.schema.json",
  "title": "Recipe",
  "description": "An entry in data/recipes/*.yaml. See docs/data-model.md section 3.2-3.5. Structural rules only — cross-references (task graph, ingredient usage, placeholder text, capability tiers) are checked by the semantic layer in packages/core, per docs/data-model.md section 4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "status",
    "title",
    "description",
    "base_servings",
    "ingredients",
    "scaling",
    "tasks",
    "storage",
    "authoring"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/Slug" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "in_review", "published"] },
    "title": { "$ref": "#/$defs/I18nString" },
    "description": { "$ref": "#/$defs/I18nString" },
    "base_servings": { "type": "integer", "minimum": 1 },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/RecipeIngredientLine" }
    },
    "scaling": { "$ref": "#/$defs/Scaling" },
    "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Task" } },
    "storage": { "$ref": "#/$defs/Storage" },
    "authoring": { "$ref": "#/$defs/Authoring" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "published" } },
        "required": ["status"]
      },
      "then": {
        "type": "object",
        "properties": {
          "authoring": {
            "type": "object",
            "properties": {
              "reviewed_by": {
                "type": "object",
                "required": ["en", "tr"],
                "properties": {
                  "en": { "type": "string", "minLength": 1 },
                  "tr": { "type": "string", "minLength": 1 }
                }
              }
            },
            "required": ["reviewed_by"]
          }
        },
        "required": ["authoring"]
      }
    }
  ],
  "$defs": {
    "Slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "I18nString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "tr"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "tr": { "type": "string", "minLength": 1 }
      }
    },
    "RecipeIngredientLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ingredient_id", "grams", "role"],
      "properties": {
        "ingredient_id": { "$ref": "#/$defs/Slug" },
        "grams": { "type": "number", "exclusiveMinimum": 0 },
        "role": { "enum": ["main", "base", "flex", "seasoning", "staple"] },
        "optional": { "type": "boolean", "default": false },
        "note": { "$ref": "#/$defs/I18nString" },
        "portion_group": { "type": "string", "minLength": 1 },
        "follows": { "$ref": "#/$defs/Slug" }
      }
    },
    "Scaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_factor", "max_factor"],
      "properties": {
        "min_factor": { "type": "number", "exclusiveMinimum": 0 },
        "max_factor": { "type": "number", "exclusiveMinimum": 0 },
        "flex": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/FlexRange" }
        }
      }
    },
    "FlexRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ingredient_id", "min_factor", "max_factor"],
      "properties": {
        "ingredient_id": { "$ref": "#/$defs/Slug" },
        "min_factor": { "type": "number", "exclusiveMinimum": 0 },
        "max_factor": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "Op": {
      "enum": [
        "wash",
        "peel",
        "dice",
        "slice",
        "mince",
        "mix",
        "season",
        "marinate",
        "sear",
        "saute",
        "simmer",
        "boil",
        "roast",
        "bake",
        "steam",
        "blend",
        "rest",
        "cool",
        "portion",
        "store",
        "unload"
      ]
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "inputs", "outputs", "methods", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "op": { "$ref": "#/$defs/Op" },
        "inputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "needs": { "type": "array", "default": [], "items": { "type": "string", "minLength": 1 } },
        "hold_max_min": { "type": "number", "minimum": 0 },
        "hold_kind": { "enum": ["safety", "quality", "continuity"] },
        "on_hold_exceeded": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "text"],
          "properties": {
            "action": { "enum": ["refrigerate", "keep_covered", "discard_advice"] },
            "text": { "$ref": "#/$defs/I18nString" }
          }
        },
        "optional": { "type": "boolean", "default": false },
        "batch_key": { "type": "string", "pattern": "^[a-z_]+:[a-z0-9_]+$" },
        "methods": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Method" } },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "required": ["brief", "detailed"],
          "properties": {
            "brief": { "$ref": "#/$defs/I18nString" },
            "detailed": { "$ref": "#/$defs/I18nString" }
          }
        }
      },
      "dependentRequired": {
        "hold_max_min": ["hold_kind"]
      },
      "allOf": [
        {
          "if": {
            "properties": { "hold_kind": { "const": "safety" } },
            "required": ["hold_kind"]
          },
          "then": { "type": "object", "required": ["on_hold_exceeded"] }
        },
        {
          "if": {
            "properties": { "hold_kind": { "const": "continuity" } },
            "required": ["hold_kind"]
          },
          "then": {
            "type": "object",
            "properties": { "hold_max_min": { "type": "number", "maximum": 5 } }
          }
        }
      ]
    },
    "Method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "active"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "baseline": { "type": "boolean", "default": false },
        "requires": { "type": "array", "default": [], "items": { "$ref": "#/$defs/Requirement" } },
        "active": { "$ref": "#/$defs/Duration" },
        "passive": { "$ref": "#/$defs/Duration" },
        "passive_unattended": { "type": "boolean", "default": false },
        "quality": { "enum": ["same", "better"] },
        "max_batch_g": { "type": "number", "exclusiveMinimum": 0 },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "required": ["brief", "detailed"],
          "properties": {
            "brief": { "$ref": "#/$defs/I18nString" },
            "detailed": { "$ref": "#/$defs/I18nString" }
          }
        }
      }
    },
    "Requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "min_liters": { "type": "number", "exclusiveMinimum": 0 },
        "sizes_l": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 } },
        "trays": { "type": "integer", "minimum": 1 },
        "temp_c": { "type": "number" },
        "tolerance_c": { "type": "number", "minimum": 0 },
        "phases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["active", "passive"] }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "capability": { "const": "oven" } },
            "required": ["capability"]
          },
          "then": { "type": "object", "required": ["temp_c", "tolerance_c", "trays"] }
        }
      ]
    },
    "Duration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixed_min": { "type": "number", "minimum": 0, "default": 0 },
        "per_100g_min": { "type": "number", "minimum": 0, "default": 0 },
        "per_unit_min": { "type": "number", "minimum": 0 },
        "scales": { "type": "boolean", "default": true }
      }
    },
    "Storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fridge_days", "freezer_days", "cooling_note", "reheat"],
      "properties": {
        "fridge_days": { "type": "integer", "minimum": 0 },
        "freezer_days": { "type": ["integer", "null"], "minimum": 0 },
        "cooling_note": { "$ref": "#/$defs/I18nString" },
        "reheat": { "$ref": "#/$defs/I18nString" }
      }
    },
    "Authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "reviewed_by", "reviewed_at"],
      "properties": {
        "author": { "type": "string", "minLength": 1 },
        "reviewed_by": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "reviewed_at": { "type": ["string", "null"] }
      }
    }
  }
}
